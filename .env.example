# ==============================================================================
# ClipForge Server Configuration
# Copy this file to .env and adjust for your deployment.
# ==============================================================================

# Host bind address and port for Docker Compose port mapping.
# Keep 127.0.0.1:3000 when running behind a reverse proxy (Nginx, Caddy, NPM).
CLIPFORGE_HOST_BIND=127.0.0.1:3000

# Publicly reachable URL for generated share links (no trailing slash).
# Example: https://clips.example.com
CLIPFORGE_PUBLIC_BASE_URL=

# ==============================================================================
# Storage Mode
# Choose either "s3" (external RustFS / S3) OR "local" (filesystem).
# ==============================================================================

# --- Mode 1: External RustFS / S3 (Default) ---
# Connects to an external RustFS or S3-compatible endpoint (no local S3 container).
CLIPFORGE_STORAGE_BACKEND=s3
S3_ENDPOINT=https://s3.emkacz.dev
S3_BUCKET=clipforge
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Mode 2: Local Filesystem Storage (Zero S3 Credentials) ---
# Uncomment the two lines below and set CLIPFORGE_STORAGE_BACKEND=local to store
# uploaded clips directly inside the persistent /data volume.
# CLIPFORGE_STORAGE_BACKEND=local
# CLIPFORGE_STORAGE_PATH=/data/clips

# ==============================================================================
# Upload, Auth & Logging
# ==============================================================================

# Maximum allowed clip upload size in bytes (default: 524288000 = 500 MiB)
CLIPFORGE_MAX_UPLOAD_BYTES=524288000

# Multipart upload chunk size in bytes (default: 8388608 = 8 MiB)
CLIPFORGE_CHUNK_SIZE_BYTES=8388608

# Allow new users to self-register via /api/v1/auth/register
CLIPFORGE_REGISTRATION_ENABLED=true

# Session / API token default lifetime in hours (default: 720 = 30 days)
CLIPFORGE_SESSION_TTL_HOURS=720

# Tracing log filter
RUST_LOG=clipforge_server=info,tower_http=info
